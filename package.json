{
  "name": "@kaykesiquara/prumo",
  "version": "0.1.0",
  "description": "Prumo, a design system measured before it is claimed: OKLCH tokens, a seven-state contract for every control and accessible React components.",
  "type": "module",
  "license": "MIT",
  "author": "Kayke Siquara Mendonça",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/lib/prumo.js",
  "module": "./dist/lib/prumo.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/prumo.js"
    },
    "./styles.css": "./dist/lib/prumo.css",
    "./tokens.json": "./tokens/tokens.json",
    "./tailwind.css": "./src/styles/tailwind-theme.css"
  },
  "files": [
    "dist/lib",
    "dist/types",
    "tokens/tokens.json",
    "src/styles/tailwind-theme.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "vite",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "build:lib": "npm run tokens && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "typescript": "~5.7",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.1.1"
  }
}
